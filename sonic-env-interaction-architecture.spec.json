  "cards": [
    {
      "dot": "cyan",
      "title": "唯一合同",
      "items": [
        "训练侧只调 env.step(动作批)，环境只回 obs/reward/done 三件批",
        "ManagerEnvWrapper 是翻译官：PyTorch 张量 ↔ 引擎格式",
        "done 的 env 在环境内部自动 reset + 换考题，训练循环不用管"
      ]
    },
    {
      "dot": "rose",
      "title": "插件层的活",
      "items": [
        "observations：从几千个物理量里挑 obs_dim 维（谁看得见什么）",
        "privileged.yaml：质量/摩擦只给 Critic——Actor 看了部署就失效",
        "events：每局重抽推力/质量/摩擦——把世界恶意预演一遍"
      ]
    },
    {
      "dot": "emerald",
      "title": "性能账",
      "items": [
        "env.step 一次 ≈2-5ms：4096 个世界 GPU 并行积分",
        "4096 场考试同时进行仍只要 1-2 秒——CPU 串行要 2.3 小时",
        "GPU 并行是'能不能训'的前提，不是优化"
      ]
    }
